diff --git a/XIPivot.Core/src/ChapterReadPaths.h b/XIPivot.Core/src/ChapterReadPaths.h
new file mode 100644
index 0000000..ed2cd55
--- /dev/null
+++ b/XIPivot.Core/src/ChapterReadPaths.h
@@ -0,0 +1,94 @@
+#pragma once
+// VanaDreams Chapter I opt-in. Scope: exactly three game-root read aliases.
+#include <array>
+#include <cstring>
+#include <utility>
+#include <filesystem>
+#include <string>
+#include <Windows.h>
+
+namespace XiPivot::Core
+{
+    class ChapterReadPaths final
+    {
+        struct Alias { std::string gamePath, overlayPath; };
+        std::array<Alias, 3> m_aliases {};
+        bool m_enabled = false;
+
+        static bool usablePath(const char* path)
+        {
+            if (!path || !*path) return false;
+            // Never alias device or extended-namespace paths.
+            if ((path[0] == '\\' || path[0] == '/') && (path[1] == '\\' || path[1] == '/')) return false;
+            return true;
+        }
+
+        static std::string absolute(const char* path)
+        {
+            if (!usablePath(path)) return {};
+            char normal[MAX_PATH];
+            auto n = GetFullPathNameA(path, MAX_PATH, normal, nullptr);
+            if (!n || n >= MAX_PATH) return {};
+            return normal;
+        }
+
+    public:
+        bool enabled() const noexcept { return m_enabled; }
+
+        void clear() noexcept { m_enabled = false; }
+
+        bool set(const std::string& gameRoot, const std::string& datRoot, const std::string& overlay)
+        {
+            clear();
+            if (overlay != "vanadreams-chapter-i" && overlay != "vanadreams-chapter-i-hair" &&
+                overlay != "vanadreams-chapter-i-official") return false;
+            const std::filesystem::path game(gameRoot), dat(datRoot);
+            if (!game.is_absolute() || !dat.is_absolute()) return false;
+            const std::array<const char*, 3> files = { "FTABLE.DAT", "VTABLE.DAT", "ROM/118/114.DAT" };
+            for (size_t i = 0; i < files.size(); ++i)
+            {
+                const auto src = (game / files[i]).string();
+                const auto dst = (dat / overlay / files[i]).string();
+                auto srcAbs = absolute(src.c_str());
+                auto dstAbs = absolute(dst.c_str());
+                std::error_code ec;
+                if (srcAbs.empty() || dstAbs.empty() || _stricmp(srcAbs.c_str(), dstAbs.c_str()) == 0 ||
+                    !std::filesystem::is_regular_file(srcAbs, ec) || ec ||
+                    !std::filesystem::is_regular_file(dstAbs, ec) || ec) return false;
+                m_aliases[i] = { std::move(srcAbs), std::move(dstAbs) };
+            }
+            m_enabled = true;
+            return true;
+        }
+
+        const char* lookup(const char* path) const
+        {
+            if (!m_enabled || !usablePath(path)) return nullptr;
+            // Fast reject every path that cannot contain one of the three exact basenames.
+            const auto n = strlen(path);
+            if ((n < 10 || _stricmp(path + n - 10, "FTABLE.DAT") != 0) &&
+                (n < 10 || _stricmp(path + n - 10, "VTABLE.DAT") != 0) &&
+                (n < 7  || _stricmp(path + n - 7,  "114.DAT") != 0)) return nullptr;
+            char key[MAX_PATH];
+            auto keyLength = GetFullPathNameA(path, MAX_PATH, key, nullptr);
+            if (keyLength > 0 && keyLength < MAX_PATH)
+                for (const auto& alias : m_aliases)
+                    if (_stricmp(key, alias.gamePath.c_str()) == 0) return alias.overlayPath.c_str();
+            return nullptr;
+        }
+
+        static bool readOnly(DWORD access, DWORD creation, DWORD flags)
+        {
+            constexpr DWORD writes = GENERIC_WRITE | GENERIC_ALL | DELETE | FILE_WRITE_DATA |
+                FILE_APPEND_DATA | FILE_WRITE_ATTRIBUTES | FILE_WRITE_EA | WRITE_DAC | WRITE_OWNER |
+                MAXIMUM_ALLOWED;
+            return creation == OPEN_EXISTING && !(access & writes) && !(flags & FILE_FLAG_DELETE_ON_CLOSE);
+        }
+
+        static bool readOnly(const char* mode)
+        {
+            // Strict plain _fopen_s() read flavours. Do not intercept update or write access.
+            return mode && (!strcmp(mode, "r") || !strcmp(mode, "rb") || !strcmp(mode, "rt"));
+        }
+    };
+}

<UserControl x:Class="Vanadreams.Pages.CapturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Vanadreams.Localization"
             xmlns:local="clr-namespace:Vanadreams"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="{lang:Text Key=t8e37445a9d05}"/>
                <ListBox Grid.Row="1" x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="List_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid MinHeight="54" Background="Transparent">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="hand" Style="{StaticResource Hand}" Visibility="Hidden" FontSize="22"/>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="hand" Property="Visibility" Value="Visible"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MenuItemText}" FontSize="21" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0" Text="{lang:Text Key=t0b3473f28352}"/>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="{lang:Text Key=t1514b18b0a14}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="SelName" Style="{StaticResource Display40}" FontSize="29" Text="—" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelMeta" Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock x:Name="SelUser" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Foreground="{StaticResource Bad}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12" Text="{lang:Text Key=td20c5a39a8a4}"/>
                        <TextBlock x:Name="Result" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button x:Name="SendButton" Style="{StaticResource GoldButton}" Content="{lang:Text Key=t448595c43769}" Click="Send_Click" Margin="0,0,7,7"/>
                        <Button x:Name="ImportButton" Style="{StaticResource GoldButton}" Content="{lang:Text Key=tc36e24cd0a3f}" Click="Import_Click" Margin="0,0,7,7"/>
                        <Button x:Name="StatusButton" Style="{StaticResource GhostButton}" Content="{lang:Text Key=t6a9d007303c1}" Click="Status_Click" Margin="0,0,7,7"/>
                        <Button Style="{StaticResource GhostButton}" Content="{lang:Text Key=tb702096a5565}" Click="Folder_Click" Margin="0,0,0,7"/>
                    </WrapPanel>
                    <local:CrewGuide Who="moogle" BubbleWidth="140"
                                     Tip="{lang:Text Key=tc43600adde87}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

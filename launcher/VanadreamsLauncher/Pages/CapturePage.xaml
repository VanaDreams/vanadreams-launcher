<UserControl x:Class="Vanadreams.Pages.CapturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vanadreams"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="✦ Snapshots"/>
                <ListBox Grid.Row="1" x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="List_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid MinHeight="54" Background="Transparent">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="hand" Style="{StaticResource Hand}" Visibility="Hidden" FontSize="22"/>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="hand" Property="Visibility" Value="Visible"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MenuItemText}" FontSize="21" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0" Text="Snapshots come from the charcapture addon: load it on the character you want to bring and type /capture. Files live in config\charcapture. Two steps: Send to Vanadreams uploads it, then Try import now asks for the import. You must first MAKE a Vanadreams character with exactly the same name (the import overwrites it) and keep it logged out."/>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Send to Vanadreams"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="SelName" Style="{StaticResource Display40}" FontSize="29" Text="—" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelMeta" Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock x:Name="SelUser" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Foreground="{StaticResource Bad}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12" Text="FIRST, MAKE A CHARACTER on Vanadreams with exactly the same name as this one, then log it out. The import overwrites that character. If it does not exist, nothing is imported."/>
                        <TextBlock x:Name="Result" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button x:Name="SendButton" Style="{StaticResource GoldButton}" Content="Send to Vanadreams" Click="Send_Click" Margin="0,0,7,7"/>
                        <Button x:Name="ImportButton" Style="{StaticResource GoldButton}" Content="Try import now" Click="Import_Click" Margin="0,0,7,7"/>
                        <Button x:Name="StatusButton" Style="{StaticResource GhostButton}" Content="Check result" Click="Status_Click" Margin="0,0,7,7"/>
                        <Button Style="{StaticResource GhostButton}" Content="Open snapshot folder" Click="Folder_Click" Margin="0,0,0,7"/>
                    </WrapPanel>
                    <local:CrewGuide Who="moogle" BubbleWidth="140"
                                     Tip="Kupo! Make a character with the same name on Vanadreams first. Then type&#160;/&#x2060;capture in game, send it here, and press Try&#160;import&#160;now."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="Vanadreams.Pages.WindowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Vanadreams.Localization"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="Step" TargetType="Button" BasedOn="{StaticResource GoldButton}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Box}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Style="{StaticResource Eyebrow}" Text="{lang:Text Key=t5325432e4259}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{lang:Text Key=t72f03b8c1d82}"/>

                    <!-- 1. the look-alikes -->
                    <TextBlock Style="{StaticResource MenuItemText}" FontSize="19" Text="{lang:Text Key=ted475910d2fa}"/>
                    <TextBlock x:Name="PresetList" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap"/>
                    <Button x:Name="PresetButton" Style="{StaticResource Step}" Content="{lang:Text Key=tef42de9bae45}" Click="Preset_Click"/>

                    <!-- 2. init.txt -->
                    <TextBlock Style="{StaticResource MenuItemText}" FontSize="19" Text="{lang:Text Key=t961346d14450}" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap"
                               Text="{lang:Text Key=tb326efcc3586}"/>
                    <Button x:Name="InitButton" Style="{StaticResource Step}" Content="{lang:Text Key=t64b124e8a2cb}" Click="Init_Click"/>

                    <!-- 3. GearSwap -->
                    <TextBlock Style="{StaticResource MenuItemText}" FontSize="19" Text="{lang:Text Key=t736f20621b47}" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap"
                               Text="{lang:Text Key=ta642ba8ca38f}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource Muted}" FontSize="13.5" VerticalAlignment="Center" Text="{lang:Text Key=tfaf3e90bda92}" Margin="0,0,8,0"/>
                        <TextBox x:Name="CharacterBox" Width="160" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{lang:Text Key=t3826b679f569}"/>
                        <Button x:Name="GearSwapButton" Style="{StaticResource Step}" Content="{lang:Text Key=t3cf7511675f3}" Click="GearSwap_Click" Margin="0"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="{lang:Text Key=t45e1facbf0f2}"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ProgressBar x:Name="Progress" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <ScrollViewer Grid.Row="1" x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="Result" TextWrapping="Wrap" FontSize="14.5" Text="{lang:Text Key=t627e0530a186}"/>
                    </ScrollViewer>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button x:Name="OpenButton" Style="{StaticResource GhostButton}" Content="{lang:Text Key=te241ab00707c}" Click="Open_Click" Margin="0,0,0,7" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <Button Style="{StaticResource GhostButton}" Content="{lang:Text Key=t76900f1bfd16}" HorizontalAlignment="Left" Click="Back_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="Vanadreams.Pages.WindowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Vanadreams.Localization">
    <!-- The game window for the current profile: mode, size, display and frame rate. Self-contained: drop it in any box. -->
    <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Text="{lang:Text Key=t79b681e0d0de}"/>
        <TextBlock Style="{StaticResource Display40}" FontSize="27" Text="{lang:Text Key=ta9e4cb28c1d1}" Margin="0,0,0,10"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{lang:Text Key=t19734a1b58ca}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <WrapPanel Grid.Column="1" x:Name="Modes"/>
            <TextBlock Grid.Row="1" Text="{lang:Text Key=t1af851907331}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <WrapPanel Grid.Row="1" Grid.Column="1" x:Name="Sizes"/>
            <TextBlock Grid.Row="2" Text="{lang:Text Key=t4c2e1df4570b}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MonitorBox" HorizontalAlignment="Left" MinWidth="170" FontSize="14" Margin="0,0,0,8"
                      SelectionChanged="Monitor_Changed" ToolTip="{lang:Text Key=t38089552b11d}"/>
            <TextBlock Grid.Row="3" Text="{lang:Text Key=tff75ad22e04d}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <WrapPanel Grid.Row="3" Grid.Column="1" x:Name="Rates"/>
        </Grid>
    </StackPanel>
</UserControl>

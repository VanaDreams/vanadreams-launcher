<UserControl x:Class="Vanadreams.Pages.GraphicsPresetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Vanadreams.Localization">
    <!-- Potato, Balanced or Pretty for the current profile. Self-contained: drop it in any box. -->
    <StackPanel>
        <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="{lang:Text Key=te70b4a7a63b3}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Style="{StaticResource Display40}" FontSize="27" Text="{lang:Text Key=t87a22766c2ad}" Margin="0,0,0,10"/>
        <StackPanel x:Name="Choices"/>
        <TextBlock x:Name="Note" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="{lang:Text Key=tb72abc408cd4}"/>
    </StackPanel>
</UserControl>

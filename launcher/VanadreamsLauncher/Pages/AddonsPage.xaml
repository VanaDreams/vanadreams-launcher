<UserControl x:Class="Vanadreams.Pages.AddonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Vanadreams.Localization"
             xmlns:local="clr-namespace:Vanadreams"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{lang:Text Key=t3cf65c955e1c}" FontSize="12.5" Padding="10,1"
                            VerticalAlignment="Top" Margin="8,0,0,0" Click="Windower_Click"
                            ToolTip="{lang:Text Key=t32717a2e3e17}"/>
                    <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="{lang:Text Key=tdcf21dc7a422}" TextWrapping="Wrap"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5,0,9">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Rows}" SizeChanged="SectionRows_SizeChanged">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="27" Margin="0,0,12,0" Background="Transparent" MouseLeftButtonUp="Row_Click" Tag="{Binding}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Hand}" FontSize="18" Margin="0,-3,0,0" Visibility="{Binding HandVisibility}"/>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanTick}" VerticalAlignment="Center" Click="Check_Click" Tag="{Binding}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" Opacity="{Binding Opacity}" TextWrapping="Wrap" Margin="0,3"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Tag}" FontSize="11" FontWeight="ExtraBold" Foreground="{Binding TagBrush}" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps" Margin="4,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="{lang:Text Key=tdf622343962d}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="ItemName" Style="{StaticResource Display40}" FontSize="27" Text="—" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ItemMeta" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ItemDesc" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ItemState" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ItemV3" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="Progress" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" FontSize="13.5" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button x:Name="InstallButton" Style="{StaticResource GoldButton}" Content="{lang:Text Key=t569ca49f4aaf}" Click="Install_Click" Margin="0,0,7,7" MinWidth="110"/>
                        <Button x:Name="DocsButton" Style="{StaticResource GhostButton}" Content="{lang:Text Key=t559b1cc46027}" Click="Docs_Click" Margin="0,0,7,7"/>
                        <Button x:Name="ConfigButton" Style="{StaticResource GhostButton}" Content="{lang:Text Key=tdfa7029514da}" Click="Config_Click" Margin="0,0,7,7"/>
                        <Button x:Name="SwitcherButton" Style="{StaticResource GhostButton}" Content="{lang:Text Key=t27cced67785a}" Click="Switcher_Click" Margin="0,0,7,7" Visibility="Collapsed"/>
                    </WrapPanel>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource GoldButton}" Content="{lang:Text Key=t1509f561f241}" Click="Save_Click" MinWidth="110" VerticalAlignment="Center"
                                ToolTip="{lang:Text Key=teacba256aa8d}"/>
                        <TextBlock x:Name="Footer" Style="{StaticResource Muted}" FontSize="13" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- under the buttons, never over them -->
                    <local:CrewGuide Who="goblin" BubbleWidth="140"
                                     Tip="{lang:Text Key=tec33e074cfdf}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

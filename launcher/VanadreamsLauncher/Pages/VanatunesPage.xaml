<UserControl x:Class="Vanadreams.Pages.VanatunesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Vanadreams.Localization"
             xmlns:local="clr-namespace:Vanadreams"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Style="{StaticResource Eyebrow}" Text="{lang:Text Key=t62a990590575}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="{lang:Text Key=tcb8a24909a5b}"/>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="{lang:Text Key=t2be652d19212}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,0,0,5" Text="{lang:Text Key=t9743b8725307}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,0,0,5" Text="{lang:Text Key=tf8aca14f370d}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,0,0,5" Text="{lang:Text Key=t37cb851dc818}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,0,0,5" Text="{lang:Text Key=tf502f7d35776}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Text="{lang:Text Key=t4464ebb4b728}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="{lang:Text Key=t1ba8bcdf19e8}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Display40}" FontSize="29" Text="{lang:Text Key=t90f3792a66b0}"/>
                        <TextBlock x:Name="State" Style="{StaticResource Mono}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                        <CheckBox x:Name="EnabledBox" Click="Enabled_Click">
                            <TextBlock Text="{lang:Text Key=t5bf8cd75c3d5}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock x:Name="Songs" Style="{StaticResource Mono}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Note" Style="{StaticResource Muted}" FontSize="13.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button Style="{StaticResource GhostButton}" Content="{lang:Text Key=tc5a87e45b243}" Click="Folder_Click" Margin="0,0,7,7"/>
                        <Button x:Name="GetButton" Style="{StaticResource GhostButton}" Content="{lang:Text Key=t6ea68412d83f}" Click="Get_Click" Margin="0,0,0,7"/>
                    </WrapPanel>
                    <local:CrewGuide Who="mandragora" BubbleWidth="140"
                                     Tip="{lang:Text Key=taa35dc30b116}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

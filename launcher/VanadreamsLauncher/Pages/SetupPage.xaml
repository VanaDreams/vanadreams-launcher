<UserControl x:Class="Vanadreams.Pages.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Vanadreams.Localization"
             xmlns:local="clr-namespace:Vanadreams"
             xmlns:pages="clr-namespace:Vanadreams.Pages"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="{lang:Text Key=t1fe934169ad4}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock x:Name="Title" Style="{StaticResource Display40}" FontSize="25" TextWrapping="Wrap" Text="{lang:Text Key=te015edffe3e7}"/>
                        <TextBlock x:Name="Lede" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" Text="{lang:Text Key=tc9b42939b615}"/>
                        <TextBlock Text="{lang:Text Key=t8662260bac58}" Style="{StaticResource Muted}"/>
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{lang:Text Key=t7ca41615c19b}" Padding="12,3" Margin="8,0,0,0" Click="Choose_Click"/>
                        </Grid>
                        <StackPanel x:Name="ImportPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ImportLabel" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ImportProfiles" Content="{lang:Text Key=t819a5f51ede6}" IsChecked="True" Margin="0,4,0,2"/>
                            <CheckBox x:Name="ImportConfigs" IsChecked="True" Margin="0,2,0,10">
                                <TextBlock Text="{lang:Text Key=t274a57db7705}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                        <ProgressBar x:Name="Progress" Visibility="Collapsed" Margin="0,4,0,4"/>
                        <TextBlock x:Name="Status" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button x:Name="GoButton" Style="{StaticResource GoldButton}" Content="{lang:Text Key=tf3698484db3e}" Click="Go_Click" Margin="0,0,10,6"/>
                    <Button x:Name="AdoptButton" Style="{StaticResource GhostButton}" Content="{lang:Text Key=t47db05e61419}" Margin="0,0,10,6" Click="Adopt_Click" Visibility="Collapsed"/>
                    <Button Style="{StaticResource GhostButton}" Content="{lang:Text Key=t675299c2d945}" Margin="0,0,0,6" Click="InstallGame_Click"/>
                </WrapPanel>
                <!-- under Check and update, in its own control so it can move -->
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Margin="0,4,0,0" Padding="0,8,0,0">
                    <pages:BugReportPanel/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{lang:Text Key=te193b296c62e}"/>
                        <TextBlock x:Name="Step1" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="{lang:Text Key=t44904788c6b6}"/>
                        <TextBlock x:Name="Step2" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="{lang:Text Key=t7ab748b58108}"/>
                        <TextBlock x:Name="Step3" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="{lang:Text Key=t76a53340d890}"/>
                        <TextBlock x:Name="Step4" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="{lang:Text Key=t7f1c031d0038}"/>
                        <TextBlock x:Name="Step5" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="{lang:Text Key=tb460f9e39c44}"/>
                    </StackPanel>
                </ScrollViewer>
                <local:CrewGuide Grid.Row="1" Who="goblin" BubbleWidth="140"
                                 Tip="{lang:Text Key=t8afc623b117b}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

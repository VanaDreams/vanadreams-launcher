<Window x:Class="Vanadreams.InstallCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="assets/moon.ico" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowSky}"
        FontFamily="{StaticResource Body}" UseLayoutRounding="True">
    <Border Style="{StaticResource Box}" Margin="14">
        <StackPanel>
            <TextBlock x:Name="Heading" Style="{StaticResource Display40}" FontSize="26" TextWrapping="Wrap"/>
            <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,8,0,14"/>
            <CheckBox x:Name="IncludeDownloads" Margin="0,0,0,8" Checked="SelectionChanged" Unchecked="SelectionChanged"/>
            <TextBlock x:Name="DownloadWarning" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Preview" TextWrapping="Wrap" Margin="0,0,6,0"/>
            </ScrollViewer>
            <TextBlock x:Name="Total" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" IsCancel="True"/>
                <Button x:Name="RemoveButton" Style="{StaticResource GoldButton}" Margin="10,0,0,0" Click="Remove_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
